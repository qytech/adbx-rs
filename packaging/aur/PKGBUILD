pkgname=adbx-bin
pkgver=0.0.1
pkgrel=1
pkgdesc="Enhanced cross-platform ADB with session locking, broadcast, TUI logcat & MCP"
arch=('x86_64' 'aarch64')
url="https://github.com/Jax-Lifu/adbx-rs"
license=('MIT')
provides=('adbx')
conflicts=('adbx')
source_x86_64=("https://github.com/Jax-Lifu/adbx-rs/releases/download/v${pkgver}/adbx-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/Jax-Lifu/adbx-rs/releases/download/v${pkgver}/adbx-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('REPLACE_WITH_LINUX_X86_64_SHA256')
sha256sums_aarch64=('REPLACE_WITH_LINUX_ARM64_SHA256')

package() {
  install -Dm755 "${srcdir}/adbx" "${pkgdir}/usr/bin/adbx"
}
